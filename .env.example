# ============================================================
# VO Studio — contoh environment variables
# Salin file ini ke `.env.local` (lokal) dan isi di Vercel
# (Dashboard → Project → Settings → Environment Variables).
# JANGAN commit file .env.local yang sudah terisi ke git.
# ============================================================

# URL project Supabase (Dashboard → Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# Anon key — BOLEH dipakai browser (Dashboard → Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key — HANYA SERVER (API routes). JANGAN pernah pakai
# key ini di kode browser / commit ke repo publik.
# (Dashboard → Settings → API → service_role — rahasiakan!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# OpenAI API key — HANYA SERVER (route /api/story). Dipakai HANYA untuk
# menulis naskah cerita (gpt-4o-mini); suara tetap VoxCPM2.
# Didapat di platform.openai.com → API keys. JANGAN pernah kirim key
# ini ke frontend / commit ke repo publik. Bila kosong, fitur Cerita
# menampilkan error "OPENAI_API_KEY belum diisi" (bukan crash).
OPENAI_API_KEY=sk-xxxx

# ---- Hanya untuk worker Python (worker/.env, BUKAN Vercel) ----
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# VOXCPM_MODEL_DIR=/path/ke/voxcpm-model-local
# POLL_INTERVAL_SECONDS=10

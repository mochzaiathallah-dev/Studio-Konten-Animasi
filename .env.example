# ============================================================
# VO Studio — contoh environment variables
# Salin file ini ke `.env.local` (lokal) dan isi di Vercel
# (Dashboard → Project → Settings → Environment Variables).
# JANGAN commit file .env.local yang sudah terisi ke git.
# ============================================================

# URL project Supabase (Dashboard → Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# Anon key — BOLEH dipakai browser (Dashboard → Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key — HANYA SERVER (API routes). JANGAN pernah pakai
# key ini di kode browser / commit ke repo publik.
# (Dashboard → Settings → API → service_role — rahasiakan!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- Penulis naskah Cerita (route /api/story) — HANYA SERVER ----
# Dipakai HANYA untuk menulis naskah cerita; suara tetap VoxCPM2.
# JANGAN pernah kirim key ini ke frontend / commit ke repo publik.
# Bila kosong, fitur Cerita menampilkan error "GEMINI_API_KEY belum
# diisi" (bukan crash).
#
# CUKUP ISI SATU KEY — provider dan model dikenali OTOMATIS:
# key OpenAI diawali "sk-" → OpenAI (model gpt-4o-mini);
# key lain (Gemini, mis. diawali "AIza…" atau "AQ.…") → Gemini
# (endpoint OpenAI-kompatibel Google, model dicari otomatis dari
# daftar model, diutamakan seri Flash). Bila pencarian model gagal,
# dipakai model default itu.
#
# Gemini (gratis): key didapat di aistudio.google.com → Get API key.
GEMINI_API_KEY=AIza...
#
# Alternatif: LLM_API_KEY=... atau OPENAI_API_KEY=sk-xxxx
# (dipakai bila GEMINI_API_KEY kosong).

# ---- Hanya untuk worker Python (worker/.env, BUKAN Vercel) ----
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# VOXCPM_MODEL_DIR=/path/ke/voxcpm-model-local
# POLL_INTERVAL_SECONDS=10
